{
  "name": "hunger-map",
  "version": "1.0.0",
  "private": true,
  "description": "Hunger Map — experiencia interactiva y educativa sobre el hambre mundial con datos oficiales de FAO, PMA, UNICEF, FIDA, OMS y GRFC/IPC.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "data:worldbank": "node scripts/fetch-worldbank.mjs",
    "data:grfc": "python scripts/build-grfc.py",
    "data:geo": "node scripts/build-geo.mjs",
    "data:curated": "node scripts/build-curated.mjs",
    "data:build": "node scripts/build-dataset.mjs",
    "data": "npm run data:worldbank && npm run data:grfc && npm run data:geo && npm run data:curated && npm run data:build",
    "data:validate": "node scripts/validate-data.mjs",
    "test": "node scripts/validate-data.mjs && node scripts/test-calculations.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "lucide-react": "^0.544.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.1",
    "topojson-client": "^3.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/d3-array": "^3.2.1",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/topojson-client": "^3.1.5",
    "tailwindcss": "4.1.13",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "typescript": "^5.9.2"
  }
}
